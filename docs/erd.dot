digraph erd {
  rankdir=LR; bgcolor="white"; nodesep=0.35; ranksep=0.9;
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=9];
  clients [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>clients</b></font></td></tr><tr><td align="left">id uuid PK</td></tr><tr><td align="left">name, name_key (generated)</td></tr><tr><td align="left">status, currency (fixed once money exists)</td></tr><tr><td align="left">source_system + source_id  UNIQUE</td></tr></table>>];
  markets [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>markets</b></font></td></tr><tr><td align="left">id uuid PK</td></tr><tr><td align="left">client_id FK</td></tr><tr><td align="left">name   UNIQUE(client_id, name)</td></tr><tr><td align="left">timezone (FK to IANA names)</td></tr></table>>];
  service_types [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>service_types</b></font></td></tr><tr><td align="left">id uuid PK</td></tr><tr><td align="left">code UNIQUE</td></tr></table>>];
  market_budgets [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFF6E0"><tr><td bgcolor="#C77D00"><font color="white"><b>market_budgets</b></font></td></tr><tr><td align="left">market_id FK, service_type_id FK</td></tr><tr><td align="left">budget_month (first of month)</td></tr><tr><td align="left">amount_cents bigint</td></tr><tr><td align="left"><b>UNIQUE(market, service, month)</b></td></tr></table>>];
  leads [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>leads</b></font></td></tr><tr><td align="left">market_id FK, service_type_id FK</td></tr><tr><td align="left">source_system + source_id  UNIQUE</td></tr><tr><td align="left">received_at timestamptz</td></tr></table>>];
  contractors [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>contractors</b></font></td></tr><tr><td align="left">id uuid PK, name, status</td></tr></table>>];
  lead_deliveries [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>lead_deliveries</b></font></td></tr><tr><td align="left">lead_id FK, contractor_id FK</td></tr><tr><td align="left">price_cents int  (finest detail)</td></tr><tr><td align="left">UNIQUE(lead, contractor)</td></tr></table>>];
  invoices [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>invoices</b></font></td></tr><tr><td align="left">client_id + currency FK, period_start/end</td></tr><tr><td align="left">UNIQUE(client, period_start)</td></tr><tr><td align="left">issued_at, invoice_number</td></tr><tr><td align="left">UNIQUE(client, number), gap-free</td></tr><tr><td align="left"><i>issued = frozen; no total column</i></td></tr></table>>];
  invoice_lines [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAF2FF"><tr><td bgcolor="#2B5FB4"><font color="white"><b>invoice_lines</b></font></td></tr><tr><td align="left">invoice_id FK</td></tr><tr><td align="left">lead_delivery_id FK <b>UNIQUE</b></td></tr></table>>];
  memberships [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#EAFBEA"><tr><td bgcolor="#2E7D32"><font color="white"><b>memberships (RLS key)</b></font></td></tr><tr><td align="left">user_id FK auth.users, client_id FK</td></tr><tr><td align="left">role owner/analyst/viewer</td></tr></table>>];
  audit [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#F3F3F3"><tr><td bgcolor="#555555"><font color="white"><b>audit.log (one shared)</b></font></td></tr><tr><td align="left">table, op, row_id, old/new jsonb</td></tr><tr><td align="left">actor, jwt_role, request_id, txid</td></tr><tr><td align="left">append-only, monthly partitions</td></tr><tr><td align="left">no policy: app roles cannot read</td></tr></table>>];
  credit_notes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFF6E0"><tr><td bgcolor="#C77D00"><font color="white"><b>credit_notes</b></font></td></tr><tr><td align="left">invoice_id + client_id + currency FK</td></tr><tr><td align="left">credit_number (assigned), amount_cents</td></tr><tr><td align="left">reason; never edited or deleted</td></tr><tr><td align="left">sum of credits &lt;= invoice total</td></tr></table>>];
  invoice_totals [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" style="dashed"><tr><td><b>view invoice_totals</b></td></tr><tr><td align="left">total = sum of delivery prices</td></tr></table>>];
  clients -> markets; markets -> market_budgets; service_types -> market_budgets; markets -> leads; service_types -> leads;
  leads -> lead_deliveries; contractors -> lead_deliveries; clients -> invoices; invoices -> invoice_lines; lead_deliveries -> invoice_lines;
  invoices -> credit_notes; clients -> memberships; invoice_lines -> invoice_totals [style=dashed]; clients -> audit [style=dotted, label="triggers on low-volume tables"];
}
